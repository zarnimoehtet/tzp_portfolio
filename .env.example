# -----------------------------------------------------------------------------
# Copy to .env.local for development. Set the same values in Vercel → Settings
# → Environment Variables for production. Never commit real values.
# -----------------------------------------------------------------------------

# Public URL of the website (used for canonical URLs, sitemap and Open Graph).
# Falls back to the Vercel production URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API. The anon key is safe in the browser;
# Row Level Security protects all data. No service-role key is required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 → Manage R2 API Tokens (Object Read & Write on one bucket).
# Server-only: these are never sent to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL without a trailing slash, e.g. https://images.yourdomain.com
# (custom domain, recommended) or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Optional: "webp" (default, fast to encode) or "avif" (smaller, slower uploads).
IMAGE_FORMAT=webp
